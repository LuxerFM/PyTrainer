# Editor conventions. Nothing here is enforced by CI; it exists so that
# editors stop fighting each other over indentation and line endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Comments and docstrings in this project are Ukrainian and in UTF-8. Saving a
# file in another encoding is how text turns into mojibake, so UTF-8 is not
# negotiable here.

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
indent_style = tab
